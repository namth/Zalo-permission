datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum PlatformType {
  TELEGRAM
  ZALO
  WEBHOOK
}

enum CallbackStatus {
  NONE
  PENDING
  SUCCESS
  FAILED
  CALLBACK_FAILED
}

enum CallbackType {
  HTTP_POST
  FIREBASE_FCM
}

enum ChannelAccountStatus {
  ACTIVE
  DISCONNECTED
  EXPIRED
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
}

enum AuthType {
  NONE
  BEARER
  API_KEY
  BASIC
  CUSTOM_HEADERS
}

enum AuditStatus {
  SUCCESS
  FAILED
  REJECTED
}

model UserProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zaloId       String?  @unique @map("zalo_id")
  username     String?  @unique
  passwordHash String?  @map("password_hash")
  fullName     String?  @map("full_name")
  email        String?
  phone        String?
  gender       String?
  note         String?
  role         String?  @default("user")
  status       String   @default("active")
  apiToken     String?  @map("api_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

model Workspace {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String?  @unique
  description String?
  status      String   @default("active")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channelChats         ChannelChat[]
  workspaceToolConfigs WorkspaceToolConfig[]
  webhooks             WorkspaceWebhook[]
  firebaseConfig       WorkspaceFirebaseConfig?
  auditLogs            AuditLog[]

  @@map("workspaces")
}

model ChannelAccount {
  id                   String               @id @default(uuid()) @db.Uuid
  platform             PlatformType
  accountName          String               @map("account_name")
  authType             String               @default("QR_SESSION") @map("auth_type")
  encryptedCredentials String               @map("encrypted_credentials") @db.Text
  status               ChannelAccountStatus @default(ACTIVE)
  metadata             Json?                @default("{}")
  lastSyncedAt         DateTime?            @map("last_synced_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  channelChats ChannelChat[]

  @@map("channel_accounts")
}

model ChannelChat {
  id             String       @id @default(uuid()) @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  workspaceId    String?      @map("workspace_id") @db.Uuid
  platform       PlatformType
  platformChatId String       @map("platform_chat_id")
  title          String
  chatType       String       @default("GROUP") @map("chat_type")
  isActive       Boolean      @default(true) @map("is_active")
  alwaysRespond  Boolean      @default(false) @map("always_respond")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  account   ChannelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  @@unique([platform, platformChatId])
  @@index([workspaceId])
  @@map("channel_chats")
}

model ToolGroup {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique
  name              String
  description       String?
  baseUrl           String?  @map("base_url")
  status            String   @default("active")
  authType          AuthType @default(NONE) @map("auth_type")
  defaultAuthConfig Json?    @default("{}") @map("default_auth_config")
  defaultHeaders    Json?    @default("{}") @map("default_headers")
  requiredVariables Json?    @default("[]") @map("required_variables")
  protocolType      String?  @default("REST") @map("protocol_type")
  mcpTransport      String?  @default("SSE") @map("mcp_transport")
  mcpRawConfig      Json?    @map("mcp_raw_config")
  timeoutSeconds    Int?     @default(15) @map("timeout_seconds")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tools                Tool[]
  workspaceToolConfigs WorkspaceToolConfig[]

  @@map("tool_groups")
}

model Tool {
  id               String      @id @default(uuid()) @db.Uuid
  toolGroupId      String?     @map("tool_group_id") @db.Uuid
  key              String      @unique
  name             String
  description      String?
  method           HttpMethod? @default(GET)
  path             String?
  inputSchema      Json?       @map("input_schema")
  outputSchema     Json?       @map("output_schema")
  parametersSchema Json?       @default("{}") @map("parameters_schema")
  bodySchema       Json?       @default("{}") @map("body_schema")
  responseSchema   Json?       @default("{}") @map("response_schema")
  embedding        Json?
  status           String      @default("active")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  toolGroup ToolGroup? @relation(fields: [toolGroupId], references: [id], onDelete: Cascade)

  @@index([toolGroupId])
  @@map("tools")
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  key            String?  @unique
  name           String
  description    String?
  detail         String?
  systemPrompt   String?  @map("system_prompt") @db.Text
  triggerIntents Json?    @default("[]") @map("trigger_intents")
  requiredTools  String[] @default([]) @map("required_tools")
  sopSteps       Json?    @default("[]") @map("sop_steps")
  executionMode  String   @default("FLEXIBLE_REACT") @map("execution_mode")
  isShared       Boolean  @default(false) @map("is_shared")
  embedding      Json?
  status         String   @default("active")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("skills")
}

model WorkspaceToolConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  toolGroupId           String   @map("tool_group_id") @db.Uuid
  isEnabled             Boolean  @default(true) @map("is_enabled")
  encryptedEnvOverrides String?  @map("encrypted_env_overrides") @db.Text
  disabledToolIds       Json?    @default("[]") @map("disabled_tool_ids")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolGroup ToolGroup @relation(fields: [toolGroupId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, toolGroupId])
  @@map("workspace_tool_configs")
}

model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String?         @map("workspace_id") @db.Uuid
  chatId         String?         @map("chat_id") @db.Uuid
  webhookId      String?         @map("webhook_id") @db.Uuid
  platform       PlatformType?
  senderId       String?         @map("sender_id")
  userPrompt     String?         @map("user_prompt") @db.Text
  detectedIntent String?         @map("detected_intent")
  matchedSkillId String?         @map("matched_skill_id") @db.Uuid
  executionPlan  Json?           @default("[]") @map("execution_plan")
  toolCalls      Json?           @default("[]") @map("tool_calls")
  finalResponse  String?         @map("final_response") @db.Text
  status         AuditStatus     @default(SUCCESS)
  callbackStatus CallbackStatus? @default(NONE) @map("callback_status")
  callbackType   CallbackType?   @map("callback_type")
  callbackTarget String?         @map("callback_target") @db.Text
  retryCount     Int             @default(0) @map("retry_count")
  latencyMs      Int?            @map("latency_ms")
  createdAt      DateTime        @default(now()) @map("created_at")

  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  channelChat  ChannelChat?      @relation(fields: [chatId], references: [id], onDelete: SetNull)
  webhook      WorkspaceWebhook? @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  matchedSkill Skill?            @relation(fields: [matchedSkillId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([webhookId, createdAt])
  @@map("audit_logs")
}

model WorkspaceWebhook {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  secretToken String   @map("secret_token") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  WebhookSession[]
  auditLogs AuditLog[]

  @@index([workspaceId])
  @@map("workspace_webhooks")
}

model WorkspaceFirebaseConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @unique @map("workspace_id") @db.Uuid
  projectId            String   @map("project_id") @db.VarChar(100)
  clientEmail          String   @map("client_email") @db.VarChar(255)
  encryptedCredentials String   @map("encrypted_credentials") @db.Text
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_firebase_configs")
}

model WebhookSession {
  id           String   @id @default(uuid()) @db.Uuid
  webhookId    String   @map("webhook_id") @db.Uuid
  sessionId    String   @map("session_id") @db.VarChar(128)
  senderId     String   @map("sender_id") @db.VarChar(128)
  messages     Json     @default("[]")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  webhook WorkspaceWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, sessionId])
  @@index([webhookId, senderId])
  @@map("webhook_sessions")
}

enum ContactRole {
  USER
  SUPER_ADMIN
}

model Contact {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  nickname   String?
  zaloId     String?     @unique @map("zalo_id")
  telegramId String?     @unique @map("telegram_id")
  role       ContactRole @default(USER)
  gender     String?
  birthYear  Int?        @map("birth_year")
  email      String?
  phone      String?
  hobbies    String?     @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("contacts")
}
